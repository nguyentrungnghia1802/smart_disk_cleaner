<Application x:Class="SmartDiskCleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Modern clean typography and colors -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="PrimaryTextColor" Color="#212121"/>
        <SolidColorBrush x:Key="SecondaryTextColor" Color="#757575"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1565C0"/>
        <SolidColorBrush x:Key="DangerColor" Color="#D32F2F"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
